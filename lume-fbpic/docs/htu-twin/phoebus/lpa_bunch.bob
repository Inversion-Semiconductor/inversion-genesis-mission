      <font family="Liberation Sans" style="REGULAR" size="10.0" />
    </font>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>SynopticButton</name>
    <actions>
      <action type="open_display">
        <file>htu_synoptic_lpa.bob</file>
        <macros />
        <target>window</target>
        <description>The HTU twin synoptic with the LPA bunch tied in (see generate_linked_synoptic.py)</description>
      </action>
    </actions>
    <text>HTU synoptic...</text>
    <x>588</x>
    <y>12</y>
    <width>150</width>
    <height>26</height>
  </widget>
